# Copy to .env next to docker-compose.share.yml when you give the stack to someone else.
# Do not commit real passwords.

APP_NAME="iDrive CDO"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_PERSISTENT=true

FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080

MAIL_MAILER=log
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
